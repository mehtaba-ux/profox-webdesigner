# ProFox browser build configuration
# These values are required by the Vite frontend at build time.
# Only a Supabase publishable key belongs in the browser. Never place a
# service-role or secret key in any VITE_* variable.
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Production deployment
# The application deploys through the existing Cloudflare Worker configuration in wrangler.toml.
# Cloudflare API credentials belong in GitHub Actions / deployment-provider secrets, never in this file.
# R2 is provided by the MEDIA_BUCKET Worker binding in wrangler.toml; no browser R2 credential is required.
# SUPABASE_DB_URL="postgresql://..." # Server-side migration runner only; store as a protected GitHub production secret.
# SUPABASE_ACCESS_TOKEN="sbp_..." # Supabase CLI deployment only; never expose through VITE_*.
VITE_R2_MEDIA_API_URL=""
VITE_R2_PUBLIC_DOMAIN=""

# Test-staff impersonation is disabled by default and must remain false in production.
VITE_ENABLE_TEST_STAFF_LOGIN="false" # Production CI enables this for the retained full-access departmental test users.

# Cloudflare Worker runtime (set in Worker Settings or local .dev.vars, not here):
# SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# ALLOWED_ORIGINS="https://your-frontend.example"
# ENABLE_TEST_STAFF_LOGIN="false" # Server-side Edge Function flag; never expose service credentials to Vite.

# Optional server-side providers
# Gemini/Productivity AI and Google Calendar OAuth are server-side Supabase Edge Function integrations.
# Keep their provider credentials in the approved server-side secret store/environment only.
# Never expose Gemini or Google OAuth client secrets through VITE_* variables or commit them to Git.
# AI remains optional and must continue to operate under: "ProFox executes. AI advises."
