# Dependencies
node_modules/
.pnp
.pnp.js

# Canonical package manager: npm (packageManager in package.json)
# Do not commit alternate lockfiles; Cloudflare auto-detection may otherwise
# choose Bun instead of npm and fail frozen-lockfile installation.
bun.lock
bun.lockb

# Production build outputs
dist/
dist-ssr/
build/
coverage/

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.dev.vars
.dev.vars.*
!.env.example

# Cloudflare local state
.wrangler/

# Editor & OS files
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary & Python cache
*.pyc
__pycache__/
.cache/
.temp/
