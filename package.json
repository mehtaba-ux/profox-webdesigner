{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "migrations:check": "node scripts/migrate-production.mjs",
    "migrations:apply": "node scripts/migrate-production.mjs --apply",
    "production:verify": "node scripts/verify-production-readiness.mjs",
    "production:activate-privacy": "node scripts/activate-production-privacy-consent.mjs",
    "test": "npm run test:talent-partner",
    "test:talent-partner": "tsx --test tests/talent-partner/*.test.ts",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "pages:deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-use": "^17.6.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
