{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run test:crm-part10a && npm run test:crm-part10b && npm run test:crm-part11 && npm run test:crm-part12 && npm run test:crm-part13 && vite build && node scripts/verify-supabase-build-config.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "migrations:check": "node scripts/migrate-production.mjs && npm run test:migration-reconciliation && node --check scripts/verify-project-chat-readiness.mjs && node --check scripts/verify-professional-mailbox-readiness.mjs && node --check scripts/verify-part11-release-readiness.mjs && node --check scripts/verify-part11-authenticated-production-ui.mjs && node --check scripts/verify-part12-release-readiness.mjs && node --check scripts/verify-part12-authenticated-production-ui.mjs && node --check scripts/verify-part13-release-readiness.mjs && node --check scripts/verify-part13-authenticated-production-ui.mjs",
    "migrations:apply": "node scripts/migrate-production.mjs --apply",
    "production:verify": "node scripts/verify-production-readiness.mjs && npm run production:verify-part10b && npm run production:verify-part11 && npm run production:verify-part12 && npm run production:verify-part13 && node scripts/verify-project-chat-readiness.mjs && node scripts/verify-professional-mailbox-readiness.mjs",
    "production:verify-part10b": "node scripts/verify-part10b-release-readiness.mjs",
    "production:activate-privacy": "node scripts/activate-production-privacy-consent.mjs",
    "test": "npm run test:talent-partner && npm run test:security && npm run test:migration-reconciliation && npm run test:crm-part10a && npm run test:crm-part10b && npm run test:crm-part11 && npm run test:crm-part12 && npm run test:crm-part13",
    "test:talent-partner": "tsx --test tests/talent-partner/*.test.ts",
    "test:security": "tsx --test tests/security/*.test.ts",
    "test:migration-reconciliation": "node --test tests/security/production-migration-native-reconciliation.test.mjs tests/security/production-migration-ledger-audit.test.mjs tests/security/production-migration-forward-convergence.test.mjs tests/security/part10b6-forward-reconciliation-migrations.test.mjs",
    "test:crm-part10a": "node --test tests/security/crm-sales-quotation-reconciliation-part-10a.test.mjs tests/security/crm-sales-quotation-reconciliation-part-10a-hardening.test.mjs",
    "test:crm-part10b": "node --test tests/security/crm-sales-final-quotation-send-gate-part-10b.test.mjs tests/security/crm-sales-final-quotation-send-gate-part-10b-spec-matrix.test.mjs",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "migrations:converge-part10b6": "node scripts/migrate-production.mjs --converge-part10b6",
    "test:crm-part11": "node --test tests/security/crm-sales-negotiation-next-action-part-11.test.mjs tests/security/crm-sales-negotiation-next-action-part-11-matrix.test.mjs tests/security/part11-authenticated-production-ui.test.mjs",
    "production:verify-part11": "node scripts/verify-part11-release-readiness.mjs",
    "production:verify-part11-ui": "node scripts/verify-part11-authenticated-production-ui.mjs && npm run production:verify-part12-ui",
    "test:crm-part12": "node --test tests/security/crm-sales-payment-won-activation-part-12.test.mjs tests/security/crm-sales-payment-won-activation-part-12-matrix.test.mjs tests/security/part12-authenticated-production-ui.test.mjs",
    "production:verify-part12": "node scripts/verify-part12-release-readiness.mjs",
    "production:verify-part12-ui": "node scripts/verify-part12-authenticated-production-ui.mjs && npm run production:verify-part13-ui",
    "test:crm-part13": "node --test tests/security/crm-sales-delivery-handoff-part-13.test.mjs tests/security/crm-sales-delivery-handoff-part-13-matrix.test.mjs tests/security/part13-authenticated-production-ui.test.mjs",
    "production:verify-part13": "node scripts/verify-part13-release-readiness.mjs",
    "production:verify-part13-ui": "node scripts/verify-part13-authenticated-production-ui.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-use": "^17.6.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "qs": "6.16.0"
  }
}
